// Daily statistics for ducko into the D1 database ducko-stats; see README.md.
// Deploy from this directory: npx wrangler@4 deploy
{
  "name": "ducko-stats",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // 00:30 UTC: yesterday's analytics are complete by then.
  "triggers": { "crons": ["30 0 * * *"] },
  "d1_databases": [
    // TODO: create a new D1 database for ducko-stats (`npx wrangler@4 d1 create ducko-stats`) and put its id here; this was quiet-md-stats's id.
    { "binding": "DB", "database_name": "ducko-stats", "database_id": "REPLACE_WITH_DUCKO_STATS_D1_ID", "migrations_dir": "migrations" }
  ],
  "vars": {
    // TODO: ducko.app's Cloudflare zone id (Zone Overview page); this was quiet.md's.
    "ZONE_ID": "REPLACE_WITH_DUCKO_APP_ZONE_ID",
    "GITHUB_REPO": "duckuments/ducko-md",
    // Days of Cloudflare analytics one run may fill in (a missed run catches up next time).
    "MAX_DAYS": "3"
  }
  // Secrets (npx wrangler@4 secret put <NAME>): CF_API_TOKEN, an API token with
  // Zone › Analytics › Read on ducko.app; GITHUB_TOKEN, optional, for a higher rate limit.
}
